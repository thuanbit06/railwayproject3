# ===========================
# DEPENDENCIES (Both)
# ===========================
node_modules/
**/node_modules/
**/bin/
**/obj/

# ===========================
# REACT / VITE
# ===========================
# Build outputs
frontend/dist/
frontend/build/
frontend/.cache/

# Environment files (CHỨA SECRET!)
frontend/.env
frontend/.env.local
frontend/.env.development
frontend/.env.production
frontend/.env.*.local

# Vite cache
frontend/.vite/

# Source maps (production)
*.map

# ===========================
# ASP.NET CORE
# ===========================
# Build & publish
backend/bin/
backend/obj/
backend/publish/
backend/artifacts/

# User-specific files
backend/**/.vs/
backend/**/*.user
backend/**/*.suo
backend/**/*.userprefs
backend/**/*.cache

# Publish profiles
backend/Properties/PublishProfiles/

# Azure / Cloud
backend/appsettings.*.json
!backend/appsettings.Development.json
!backend/appsettings.Production.json

# Logs
backend/logs/
backend/*.log
backend/Logs/

# EF Core migrations (optional - nhiều team vẫn track)
# backend/**/Migrations/

# Kestrel certs
backend/**/*.pfx
backend/**/*.pem

# ===========================
# DOTNET GLOBAL
# ===========================
*.swp
*.swo
*~
*.tmp
*.temp

# NuGet
**/packages/
**/.nuget/
**/project.lock.json
**/packages.lock.json

# Test results
**/TestResults/
**/Coverage/

# ===========================
# DATABASE (SQLite - từ backend mình làm)
# ===========================
**/*.sqlite
**/*.db
**/*.db-shm
**/*.db-wal

